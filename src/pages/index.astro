---
// Ce site a été regroupé avec les deux autres boulangeries sur
// mkboulangeries.fr. La redirection réelle est un 308 permanent défini
// dans vercel.json : c'est elle qui transmet le référencement acquis.
//
// Cette page n'est qu'un filet de sécurité, servie uniquement si la
// redirection d'hébergement ne s'applique pas (autre hébergeur, config
// perdue). Elle ne doit jamais laisser un visiteur dans le vide.
const destination = "https://mkboulangeries.fr/au-fournil-du-sud";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Au Fournil du Sud — nouvelle adresse du site</title>
    <link rel="canonical" href={destination} />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <p class="eyebrow">Au Fournil du Sud</p>
      <h1>Notre site a déménagé</h1>
      <p class="lede">
        Retrouvez nos horaires, notre adresse et notre numéro sur notre
        nouveau site, avec nos deux autres boulangeries.
      </p>
      <a href={destination}>Accéder au site &rarr;</a>
    </main>

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 32px;
        background: #0E1310;
        color: #F0EBE0;
        font-family: system-ui, sans-serif;
        text-align: center;
      }
      main { max-width: 34rem; }
      .eyebrow {
        margin: 0 0 18px;
        font-size: 12px;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #C9A260;
      }
      h1 { font-size: clamp(28px, 6vw, 40px); margin: 0 0 18px; font-weight: 600; }
      .lede { font-size: 16px; line-height: 1.7; color: #8A8A7A; margin: 0 0 32px; }
      a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 14px 30px;
        background: #C9A260;
        color: #0A0E0C;
        font-weight: 600;
        border-radius: 3px;
        text-decoration: none;
      }
    </style>
  </body>
</html>
